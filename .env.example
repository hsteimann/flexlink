# FlexLink Middleware Configuration

# Application Settings
APP_NAME=FlexLink
DEBUG=false
LOG_LEVEL=INFO

# File Processing Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=data/uploads
DOWNLOAD_DIR=data/downloads
TEMP_FILE_TTL_SECONDS=86400  # 24 hours (default retention for temporary files)

# Connector Configuration Directory
CONFIG_DIR=config

# External API Credentials (examples)
# NOVOMIND_API_KEY=your-pim-api-key
# SHOPWARE_ACCESS_TOKEN=your-shopware-token
# SHOPWARE_ACCESS_KEY=your-shopware-key
# BC_CLIENT_ID=your-business-central-client-id
# BC_CLIENT_SECRET=your-business-central-secret
# BC_TENANT_ID=your-tenant-id
# BC_ENVIRONMENT=production

# JSONPlaceholder Demo (no auth required)
# This is a public API for testing, no credentials needed

# PriceEdge API Configuration
PRICEEDGE_BASE_URL=https://yourdomain.priceedge.eu/papi
PRICEEDGE_KEY_NAME=your_api_key_name_here
PRICEEDGE_API_TOKEN=your_generated_token_here
